---
import type { LastFmArtist } from '../../lib/lastfm';

interface Props {
  artist: LastFmArtist;
}

const { artist } = Astro.props;

const artwork = artist.image[2]?.['#text'] || artist.image[1]?.['#text'] || '';
const playcount = parseInt(artist.playcount).toLocaleString();
---

<a
  href={artist.url}
  target="_blank"
  rel="noopener noreferrer"
  class="block bg-gray-50 rounded-lg overflow-hidden hover:bg-gray-100 transition-colors group"
>
  {artwork ? (
    <img
      src={artwork}
      alt={artist.name}
      class="w-full aspect-square object-cover group-hover:scale-105 transition-transform"
      loading="lazy"
    />
  ) : (
    <div class="w-full aspect-square bg-gray-200 flex items-center justify-center">
      <span class="text-gray-400 text-4xl">♪</span>
    </div>
  )}
  <div class="p-4">
    <h3 class="font-semibold truncate">{artist.name}</h3>
    <p class="text-gray-500 text-xs mt-1">{playcount} plays</p>
  </div>
</a>