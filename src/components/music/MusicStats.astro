---
import NowPlaying from './NowPlaying.astro';
---

<div class="space-y-12">
  <section>
    <h2 class="text-2xl font-semibold mb-4 text-gray-800">Now Playing</h2>
    <div id="now-playing-container">
      <NowPlaying loading />
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-semibold mb-4 text-gray-800">Top Tracks <span class="text-sm font-normal text-pink-400">(7 days)</span></h2>
    <div id="top-tracks-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <div class="bg-pink-50 border border-pink-100 rounded-lg p-8 text-center text-gray-500">Loading...</div>
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-semibold mb-4 text-gray-800">Top Artists <span class="text-sm font-normal text-pink-400">(7 days)</span></h2>
    <div id="top-artists-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <div class="bg-pink-50 border border-pink-100 rounded-lg p-8 text-center text-gray-500">Loading...</div>
    </div>
  </section>
</div>

<script>
  async function fetchNowPlaying() {
    try {
      const response = await fetch('/api/now-playing');
      const data = await response.json();

      const container = document.getElementById('now-playing-container');
      if (!container) return;

      if (data.error) {
        container.innerHTML = '<p class="text-gray-500">Unable to load now playing</p>';
        return;
      }

      if (data.source === 'none') {
        container.innerHTML = '<p class="text-gray-500">No music playing recently</p>';
        return;
      }

      container.innerHTML = `
        <div class="bg-white border border-pink-100 rounded-lg p-6 flex flex-col md:flex-row gap-6 items-center shadow-sm">
          ${data.artwork
          ? `<img src="${data.artwork}" alt="${data.title}" class="w-32 h-32 rounded object-cover flex-shrink-0 shadow-sm" loading="lazy" />`
          : '<div class="w-32 h-32 bg-pink-100 rounded flex items-center justify-center flex-shrink-0"><span class="text-pink-300 text-sm">No art</span></div>'
        }
          <div class="flex-1 text-center md:text-left">
            <h3 class="text-xl font-semibold mb-1 text-gray-800">
              <a href="${data.url}" target="_blank" rel="noopener noreferrer" class="hover:text-pink-500 transition-colors">${data.title}</a>
            </h3>
            <p class="text-gray-600">${data.artist}</p>
            ${data.album ? `<p class="text-gray-500 text-sm">${data.album}</p>` : ''}
            ${data.isPlaying
          ? '<span class="inline-flex items-center gap-1 mt-2 text-sm text-white bg-pink-400 px-2 py-1 rounded"><span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>Now Playing</span>'
          : ''
        }
          </div>
        </div>
      `;
    } catch (error) {
      console.error('Error fetching now playing:', error);
    }
  }

  async function fetchTopTracks() {
    try {
      const response = await fetch('/api/top-tracks?limit=12&period=7day');
      const tracks = await response.json();

      const container = document.getElementById('top-tracks-container');
      if (!container || !Array.isArray(tracks)) return;

      if (tracks.length === 0) {
        container.innerHTML = '<p class="text-gray-500 col-span-full">No tracks to display</p>';
        return;
      }

      container.innerHTML = tracks
        .map(
          (track) => {
            const artwork = track.image[2]?.['#text'] || track.image[1]?.['#text'] || '';
            const playcount = track.playcount ? parseInt(track.playcount).toLocaleString() : '';
            return `
            <a href="${track.url}" target="_blank" rel="noopener noreferrer" class="block bg-white border border-pink-100 rounded-lg overflow-hidden hover:border-pink-300 hover:shadow-md transition-all group">
              ${artwork
                ? `<img src="${artwork}" alt="${track.name}" class="w-full aspect-square object-cover group-hover:scale-105 transition-transform" loading="lazy" />`
                : '<div class="w-full aspect-square bg-pink-100 flex items-center justify-center"><span class="text-pink-300 text-4xl">♪</span></div>'
              }
              <div class="p-4">
                <h3 class="font-semibold truncate text-gray-800">${track.name}</h3>
                <p class="text-gray-600 text-sm truncate">${track.artist['#text']}</p>
                ${playcount ? `<p class="text-pink-400 text-xs mt-1">${playcount} plays</p>` : ''}
              </div>
            </a>
          `;
          }
        )
        .join('');
    } catch (error) {
      console.error('Error fetching top tracks:', error);
    }
  }

  async function fetchTopArtists() {
    try {
      const response = await fetch('/api/top-artists?limit=12&period=7day');
      const artists = await response.json();

      const container = document.getElementById('top-artists-container');
      if (!container || !Array.isArray(artists)) return;

      if (artists.length === 0) {
        container.innerHTML = '<p class="text-gray-500 col-span-full">No artists to display</p>';
        return;
      }

      container.innerHTML = artists
        .map(
          (artist) => {
            const artwork = artist.image[2]?.['#text'] || artist.image[1]?.['#text'] || '';
            const playcount = parseInt(artist.playcount).toLocaleString();
            return `
            <a href="${artist.url}" target="_blank" rel="noopener noreferrer" class="block bg-white border border-pink-100 rounded-lg overflow-hidden hover:border-pink-300 hover:shadow-md transition-all group">
              ${artwork
                ? `<img src="${artwork}" alt="${artist.name}" class="w-full aspect-square object-cover group-hover:scale-105 transition-transform" loading="lazy" />`
                : '<div class="w-full aspect-square bg-pink-100 flex items-center justify-center"><span class="text-pink-300 text-4xl">♪</span></div>'
              }
              <div class="p-4">
                <h3 class="font-semibold truncate text-gray-800">${artist.name}</h3>
                <p class="text-pink-400 text-xs mt-1">${playcount} plays</p>
              </div>
            </a>
          `;
          }
        )
        .join('');
    } catch (error) {
      console.error('Error fetching top artists:', error);
    }
  }

  // Fetch all data on load
  fetchNowPlaying();
  fetchTopTracks();
  fetchTopArtists();

  // Refresh now playing every 30 seconds
  setInterval(fetchNowPlaying, 30000);
</script>