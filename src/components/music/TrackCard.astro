---
import type { LastFmTrack } from '../../lib/lastfm';

interface Props {
  track: LastFmTrack;
}

const { track } = Astro.props;

const artwork = track.image[2]?.['#text'] || track.image[1]?.['#text'] || '';
const playcount = track.playcount ? parseInt(track.playcount).toLocaleString() : '';
---

<a
  href={track.url}
  target="_blank"
  rel="noopener noreferrer"
  class="block bg-gray-50 rounded-lg overflow-hidden hover:bg-gray-100 transition-colors group"
>
  {artwork ? (
    <img
      src={artwork}
      alt={track.name}
      class="w-full aspect-square object-cover group-hover:scale-105 transition-transform"
      loading="lazy"
    />
  ) : (
    <div class="w-full aspect-square bg-gray-200 flex items-center justify-center">
      <span class="text-gray-400 text-4xl">♪</span>
    </div>
  )}
  <div class="p-4">
    <h3 class="font-semibold truncate">{track.name}</h3>
    <p class="text-gray-600 text-sm truncate">{track.artist['#text']}</p>
    {playcount && (
      <p class="text-gray-500 text-xs mt-1">{playcount} plays</p>
    )}
  </div>
</a>