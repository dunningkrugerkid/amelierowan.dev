---
import Layout from '../components/ui/Layout.astro';
---

<Layout title="Rowan">
  <main>
    <section class="pt-16 pb-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-5xl md:text-7xl font-bold mb-4">
            Hey, I'm Rowan
          </h1>
          <p class="text-xl md:text-2xl text-gray-600 mb-8">
            Welcome to my corner of the internet
          </p>
          <div class="flex gap-4 justify-center flex-wrap">
            <a href="/music" class="px-6 py-3 rounded-lg font-medium bg-black text-white hover:bg-gray-800 transition-colors">
              Music
            </a>
            <a href="/cat" class="px-6 py-3 rounded-lg font-medium bg-gray-100 text-gray-800 hover:bg-gray-200 transition-colors">
              My Cat
            </a>
            <a href="/about" class="px-6 py-3 rounded-lg font-medium bg-gray-100 text-gray-800 hover:bg-gray-200 transition-colors">
              About
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-semibold mb-6">Now Playing</h2>
      <div id="now-playing-container" class="bg-gray-50 rounded-lg p-6">
        <div class="animate-pulse flex flex-col md:flex-row gap-6 items-center">
          <div class="w-32 h-32 bg-gray-200 rounded flex-shrink-0"></div>
          <div class="flex-1">
            <div class="h-6 bg-gray-200 rounded w-3/4 mb-2"></div>
            <div class="h-4 bg-gray-200 rounded w-1/2"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-semibold mb-6">Quick Links</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/music" class="block p-6 rounded-lg bg-gray-50 hover:bg-gray-100 transition-colors">
          <h3 class="font-semibold mb-2">Music</h3>
          <p class="text-gray-600">What I've been listening to</p>
        </a>
        <a href="/cat" class="block p-6 rounded-lg bg-gray-50 hover:bg-gray-100 transition-colors">
          <h3 class="font-semibold mb-2">My Cat</h3>
          <p class="text-gray-600">Photos of my cat</p>
        </a>
        <a href="/about" class="block p-6 rounded-lg bg-gray-50 hover:bg-gray-100 transition-colors">
          <h3 class="font-semibold mb-2">About</h3>
          <p class="text-gray-600">More about me</p>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  async function fetchNowPlaying() {
    try {
      const response = await fetch('/api/now-playing');
      const data = await response.json();

      const container = document.getElementById('now-playing-container');
      if (!container) return;

      if (data.error) {
        container.innerHTML = '<p class="text-gray-500 text-center">Unable to load now playing</p>';
        return;
      }

      if (data.source === 'none') {
        container.innerHTML = '<p class="text-gray-500 text-center">No music playing recently</p>';
        return;
      }

      container.innerHTML = `
        <div class="flex flex-col md:flex-row gap-6 items-center">
          ${data.artwork
            ? `<img src="${data.artwork}" alt="${data.title}" class="w-32 h-32 rounded object-cover flex-shrink-0" loading="lazy" />`
            : '<div class="w-32 h-32 bg-gray-200 rounded flex items-center justify-center flex-shrink-0"><span class="text-gray-400 text-sm">No art</span></div>'
          }
          <div class="flex-1 text-center md:text-left">
            <h3 class="text-xl font-semibold mb-1">
              ${data.url
                ? `<a href="${data.url}" target="_blank" rel="noopener noreferrer" class="hover:underline">${data.title}</a>`
                : data.title
              }
            </h3>
            <p class="text-gray-600">${data.artist}</p>
            ${data.album ? `<p class="text-gray-500 text-sm">${data.album}</p>` : ''}
            ${data.isPlaying
              ? '<span class="inline-flex items-center gap-1 mt-2 text-sm text-white bg-black px-2 py-1 rounded"><span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>Now Playing</span>'
              : ''
            }
          </div>
        </div>
      `;
    } catch (error) {
      console.error('Error fetching now playing:', error);
    }
  }

  fetchNowPlaying();
  setInterval(fetchNowPlaying, 30000);
</script>