---
import Layout from '../components/ui/Layout.astro';
---

<Layout title="music | rowan">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2 text-gray-800">music</h1>
    <p class="text-gray-600 mb-8">
      what i've been listening to
    </p>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4 text-gray-800">now playing</h2>
      <div id="now-playing-container" class="bg-white border border-pink-100 rounded-lg p-6">
        <div class="animate-pulse flex flex-col md:flex-row gap-6 items-center">
          <div class="w-32 h-32 bg-pink-100 rounded flex-shrink-0"></div>
          <div class="flex-1">
            <div class="h-6 bg-pink-100 rounded w-3/4 mb-2"></div>
            <div class="h-4 bg-pink-100 rounded w-1/2"></div>
          </div>
        </div>
      </div>
      <p class="text-gray-500 text-sm mt-2">shows what's playing on my mac</p>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4 text-gray-800">current favorites</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="favorites-container">
        <!-- Favorites loaded via client-side, or you can manually add here -->
      </div>
    </section>
  </main>
</Layout>

<script>
  async function fetchNowPlaying() {
    try {
      const response = await fetch('/api/now-playing');
      const data = await response.json();

      const container = document.getElementById('now-playing-container');
      if (!container) return;

      if (data.error || data.source === 'none') {
        container.innerHTML = `
          <div class="bg-pink-50 border border-pink-200 rounded-lg p-6 text-center">
            <p class="text-gray-600">nothing playing right now</p>
            <p class="text-gray-500 text-sm mt-2">open music app on my mac to see what's playing</p>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div class="flex flex-col md:flex-row gap-6 items-center">
          ${data.artwork
            ? `<img src="${data.artwork}" alt="${data.title}" class="w-32 h-32 rounded object-cover flex-shrink-0 shadow-sm" loading="lazy" />`
            : '<div class="w-32 h-32 bg-pink-100 rounded flex items-center justify-center flex-shrink-0"><span class="text-pink-300">♪</span></div>'
          }
          <div class="flex-1 text-center md:text-left">
            <h3 class="text-xl font-semibold mb-1 text-gray-800 lowercase">${data.title}</h3>
            <p class="text-gray-600 lowercase">${data.artist}</p>
            ${data.album ? `<p class="text-gray-500 text-sm lowercase">${data.album}</p>` : ''}
            ${data.isPlaying
              ? '<span class="inline-flex items-center gap-1 mt-2 text-sm text-white bg-pink-400 px-2 py-1 rounded"><span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>now playing</span>'
              : ''
            }
          </div>
        </div>
      `;
    } catch (error) {
      console.error('Error fetching now playing:', error);
      container.innerHTML = `
        <div class="bg-pink-50 border border-pink-200 rounded-lg p-6 text-center">
          <p class="text-gray-600">couldn't load music data</p>
        </div>
      `;
    }
  }

  fetchNowPlaying();
  setInterval(fetchNowPlaying, 30000);
</script>