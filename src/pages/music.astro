---
import Layout from '../components/ui/Layout.astro';
import { favoriteAlbums, favoriteTracks } from '../lib/music';
---

<Layout title="music | rowan">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2 text-gray-800">music</h1>
    <p class="text-gray-600 mb-12">
      albums and songs i've been loving lately
    </p>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6 text-gray-800">favorite albums</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {favoriteAlbums.map((album) => (
          <div class="bg-white border border-pink-100 rounded-lg overflow-hidden hover:border-pink-300 hover:shadow-md transition-all group">
            {album.cover ? (
              <img
                src={album.cover}
                alt={`${album.title} by ${album.artist}`}
                class="w-full aspect-square object-cover group-hover:scale-105 transition-transform"
                loading="lazy"
              />
            ) : (
              <div class="w-full aspect-square bg-gradient-to-br from-pink-100 to-pink-200 flex items-center justify-center">
                <span class="text-pink-300 text-6xl">♪</span>
              </div>
            )}
            <div class="p-4">
              <h3 class="font-semibold text-gray-800 lowercase truncate">{album.title}</h3>
              <p class="text-gray-600 text-sm lowercase">{album.artist}</p>
              {album.year && (
                <p class="text-pink-400 text-xs mt-1">{album.year}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-semibold mb-6 text-gray-800">on repeat</h2>
      <ul class="space-y-3">
        {favoriteTracks.map((track) => (
          <li class="bg-white border border-pink-100 rounded-lg px-4 py-3 hover:border-pink-300 transition-colors">
            <span class="text-gray-800 lowercase">{track}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>