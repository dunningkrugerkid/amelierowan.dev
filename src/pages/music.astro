---
import Layout from '../components/ui/Layout.astro';
import MusicStats from '../components/music/MusicStats.astro';
---

<Layout title="Music | Rowan">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2 text-gray-800">Music</h1>
    <p class="text-gray-600 mb-8">
      What I've been listening to lately
    </p>
    
    <MusicStats client:load />
  </main>
</Layout>