---
import Layout from '../components/ui/Layout.astro';
import CatGallery from '../components/content/CatGallery.astro';
---

<Layout title="my cat | rowan">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2 text-gray-800">my cat</h1>
    <p class="text-gray-600 mb-8">
      here's my cat! photos powered by cloudinary.
    </p>

    <CatGallery
      photos={[
        { publicId: 'cat-photos/cat-1', url: '', alt: 'Cat photo 1' },
        { publicId: 'cat-photos/cat-2', url: '', alt: 'Cat photo 2' },
        { publicId: 'cat-photos/cat-3', url: '', alt: 'Cat photo 3' },
        { publicId: 'cat-photos/cat-4', url: '', alt: 'Cat photo 4' },
        { publicId: 'cat-photos/cat-5', url: '', alt: 'Cat photo 5' },
        { publicId: 'cat-photos/cat-6', url: '', alt: 'Cat photo 6' },
      ]}
    />

    <div class="mt-8 p-6 bg-pink-50 rounded-lg border border-pink-200">
      <h2 class="text-lg font-semibold mb-2 text-gray-800">want to add photos?</h2>
      <p class="text-gray-600 text-sm">
        upload your cat photos to cloudinary in the <code class="bg-pink-100 px-1 rounded">cat-photos</code> folder
        and they'll automatically appear here!
      </p>
    </div>
  </main>
</Layout>