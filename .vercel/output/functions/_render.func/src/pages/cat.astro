---
import Layout from '../components/ui/Layout.astro';
---

<Layout title="My Cat | Rowan">
  <main class="container py-8">
    <h1 class="text-4xl font-bold mb-4">My Cat</h1>
    <p class="text-gray-600 mb-8">
      Here's my cat!
    </p>
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {Array.from({ length: 8 }, (_, i) => (
        <div class="aspect-square rounded-lg overflow-hidden bg-gray-100 group">
          <div class="w-full h-full flex items-center justify-center group-hover:bg-gray-200 transition-colors">
            <span class="text-gray-400">Cat photo {i + 1}</span>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>